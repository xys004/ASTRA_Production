# ─── LLM Provider API Keys ────────────────────────────────────────────────────
# Add at least one. ASTRA works in simulated mode if none are set.

GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ─── Google Vertex AI (optional, no API key required) ─────────────────────────
# Uses Application Default Credentials. Run once: gcloud auth application-default login
# Then set your GCP project ID below.

VERTEX_PROJECT=your_gcp_project_id
VERTEX_LOCATION=us-central1

# ─── Default Provider ─────────────────────────────────────────────────────────
# Production: codex_cli | claude_cli | agy_cli
# Optional APIs: gemini | anthropic | openai | vertexai | deepseek | xai | qwen
#               mistral | codestral | groq | perplexity
# If unset, ASTRA picks the first configured provider automatically.

ASTRA_PROVIDER=codex_cli
# Production default since 2026-09-30: `no-ensemble` (Codex proposes alone,
# post-cycle navigation opt-in; translator, reviewer, analyst and repair are
# the same as `full`). `full` adds the agy co-proposal, cross-critique and
# navigation for a deliberately deep cycle; in the 2026-09-30 canary those two
# phases were 80% of each 18-minute cycle. `quota-optimized` is an explicit
# experiment profile and must not be used for broad paper or
# research-program audits.
ASTRA_ARCHITECTURE_PROFILE=no-ensemble

# ─── Per-Phase Providers (optional) ───────────────────────────────────────────
# Override which provider handles each phase. Falls back to ASTRA_PROVIDER.
# `full` profile: ASTRA_CONJECTURE_PROVIDER=codex_cli,agy_cli

ASTRA_CONJECTURE_PROVIDER=codex_cli
ASTRA_TRANSLATOR_PROVIDER=claude_cli
ASTRA_REVIEWER_PROVIDER=codex_cli
ASTRA_ANALYST_PROVIDER=codex_cli
ASTRA_NAVIGATOR_PROVIDER=agy_cli
ASTRA_SYNTH_PROVIDER=codex_cli

# Recommended production model selection (subscription CLIs, no model API keys).
# The ladder only rescues a phase when the rungs have SEPARATE allowances: a
# weekly subscription limit is account-wide, so every Claude rung fails at once.
# For that case switch the provider's account profile instead (see
# docs/CLI_ACCOUNT_PROFILES.md).
# 2026-10-12 (1.1.9): a rung may carry its reasoning effort after "@"
# ("gpt-6.1-sol@ultra"). Efforts each CLI accepts: claude low..max, codex
# low..ultra, agy low..max (Gemini 3.8 Flash only up to high). An effort the
# CLI refuses is dropped, not sent. Phase ladders (ASTRA_<PHASE>_MODELS) win
# over the CLI-wide ones: proposing and interpreting results get the most
# inference at high (ultra and max only under MAX mode: measured 14 Oct, more
# effort bought hidden reasoning, not verdicts), the analyst xhigh, writing
# code stays on Opus at high. Codex
# 0.160 lists GPT-6.1 Sol as the account default; agy no longer offers any
# Gemini Pro. Probe a new rung with a one-word call before pinning it.
ASTRA_CLAUDE_MODELS=claude-opus-5-5@high,sonnet@high
ASTRA_CODEX_MODELS=gpt-6.1-sol@high,gpt-6-luna@high
ASTRA_CODEX_REASONING=xhigh
# Codex without its agent tools (shell, patching, web, images): ASTRA only
# asks it for text. Cuts about 7k input tokens per call. Opt-in.
ASTRA_CODEX_LEAN=0
ASTRA_ANALYST_MODELS=gpt-6.1-sol@xhigh,gpt-6-luna@high
ASTRA_REVIEWER_MODELS=gpt-6.1-sol@high,gpt-6-luna@high
ASTRA_AGY_MODELS=gemini-3.8-flash@high
ASTRA_AGY_EFFORT=high
ASTRA_TRANSLATOR_MODELS=claude-opus-5-5@high,sonnet@high
# Split authorship (opt-in): a top model writes a short validation plan, then
# the translator ladder (can start at Sonnet) writes the code from it. The
# contract then requires the planner's first rung to be Opus or Fable.
ASTRA_AUTHOR_SPLIT=0
# ASTRA_PLANNER_MODELS=claude-opus-5-5@medium,claude-fable-5-1@max
# With the split on, the planner classes the problem simple/moderate/hard;
# moderate and hard start the author here, with a longer ceiling.
# ASTRA_AUTHOR_MODELS_MODERATE=claude-opus-5-5@high,sonnet@high
# ASTRA_AUTHOR_MODELS_HARD=claude-opus-5-5@high,sonnet@high
# ASTRA_TRANSLATOR_TIMEOUT_MODERATE=1200
# ASTRA_TRANSLATOR_TIMEOUT_HARD=1500
# On a plan classed simple, the Codex reviewer and analyst step down to
# Luna (Sol stays as fallback). Conjecture runs before the plan and keeps
# its ladder; MAX mode ignores this.
ASTRA_SIMPLE_CODEX_TIER=0
# ASTRA_REVIEWER_MODELS_SIMPLE=gpt-6-luna@high,gpt-6.1-sol@high
# ASTRA_ANALYST_MODELS_SIMPLE=gpt-6-luna@high,gpt-6.1-sol@high
# Second and later code reviews only re-check a revision; a lighter ladder
# is enough. Empty keeps the first-review ladder for every round.
# ASTRA_REVIEWER_FOLLOWUP_MODELS=gpt-6-luna@high,gpt-6.1-sol@high
ASTRA_CODE_REVIEW=1
ASTRA_REVIEW_MAX_REVISIONS=1
# Post-cycle research navigation by agy (241 s per cycle measured 2026-09-30):
# opt-in under `no-ensemble`, required under `full`.
ASTRA_NAVIGATE_AFTER_CYCLE=0
# Production validator repair: deterministic local fixes + one bounded model patch.
# Set ASTRA_VALIDATOR_REPAIR_VNEXT=0 only for a frozen classic baseline.
ASTRA_VALIDATOR_REPAIR_VNEXT=1
ASTRA_VALIDATOR_REPAIR_STRATEGY=local-patch
ASTRA_VNEXT_MODEL_PATCH_MAX_REVISIONS=1
# C2 (docs/architecture/CYCLE_ROBUSTNESS_SPEC.md): classify each reviewer rejection,
# direct the next revision at the defect class, switch strategy once when the same
# class repeats, stop clean with a diagnosis if it persists. Same revision cap. 0=off.
ASTRA_REVIEW_STUCK_DETECTOR=1
# C3: provider for the opt-in request structurer (astra_cycle structure_request=true).
# Default: ASTRA_SYNTH_PROVIDER. ASTRA_STRUCTURER_MODELS / ASTRA_STRUCTURER_TIMEOUT
# follow the per-phase pattern.
#ASTRA_STRUCTURER_PROVIDER=codex_cli
# One console window per deliberative cycle (Windows): instruction, phase, progress
# bar and ETA from recent cycles' median phase durations. 0=off. The window closes
# ASTRA_PROGRESS_WINDOW_LINGER seconds after the cycle ends (-1 = until Enter).
ASTRA_PROGRESS_WINDOW=1
ASTRA_PROGRESS_WINDOW_LINGER=120
# Before the first model call, a cycle asks `claude auth status` and
# `codex login status` whether the CLIs it will use are logged in, and stops
# without spending if one is not (a logged-out CLI otherwise surfaces only in
# the translator, after the conjecture was paid). 0=off. Unknown never blocks.
ASTRA_CLI_AUTH_PREFLIGHT=1
# Cross-process resource policy. Full cycles share the same subscription
# accounts: 1 serializes them; 2 (the contract ceiling since 1.1.14) lets two
# chats run cycles at once, at twice the quota burn. A third waits for a slot
# (or gets BUSY). Independent local validators/benchmarks use the detected CPU
# capacity unless ASTRA_LOCAL_WORKERS is set explicitly.
ASTRA_MAX_CONCURRENT_CYCLES=1
# ASTRA_LOCAL_WORKERS=4
# Subscription CLI prompts and outputs use workspace\cli_tmp by default rather
# than Windows TEMP/TMP, which can be inaccessible to a desktop-hosted MCP server.
# Set only if the ASTRA workspace itself is intentionally read-only:
# ASTRA_CLI_TEMP_ROOT=C:\path\to\a\writable\astra-cli-temp

# ─── Remote Validation Oracle (optional) ─────────────────────────────────────
# Keep ASTRA UI local while running Phase 4 validation scripts on a Linux worker
# reachable over SSH/Tailscale.

# ASTRA_ORACLE_MODE=local
# ASTRA_ORACLE_MODE=remote
# ASTRA_ORACLE_TIMEOUT=600
# ASTRA_WSL_DISTRO=Debian
# ASTRA_REQUIRED_LOCAL_ENGINES=z3,sagemath,maxima,cadabra,lean4_local
# ASTRA_REMOTE_HOST=user@compute-host.example
# ASTRA_REMOTE_PYTHON=~/astra-worker/venv/bin/python
# ASTRA_REMOTE_WORKER=~/astra-worker/astra_remote_worker.py
# ASTRA_REMOTE_WORKDIR=~/astra-worker/workspace
# ASTRA_REMOTE_CONNECT_TIMEOUT=15
# ASTRA_REMOTE_ENGINE_RUNNER=~/astra-worker/astra_engine.sh
# ASTRA_REMOTE_SSH_OPTIONS=-i C:\path\to\ssh_key -o "ProxyCommand=tailscale nc %h %p"
# Shared ASTRUM scheduler. Each collaborator uses a stable, non-secret ID.
# ASTRA_CLIENT_ID=nelson
# ASTRA_PROJECT_ID=general
# ASTRA_REMOTE_SCHEDULER=1
# ASTRA_REMOTE_CLUSTER_MANAGER=~/astra-worker/astra_cluster_manager.py
# ASTRA_REMOTE_QUEUE_WAIT=300
#
# External benchmark runtimes on ASTRUM
# ASTRA_REMOTE_MINIF2F_ROOT=~/astra-benchmarks/miniF2F
# ASTRA_REMOTE_LEAN_BIN=~/.elan/bin/lean
# ASTRA_REMOTE_LEAN4_ROOT=~/astra-benchmarks/mathlib4-v4.30.0
# ASTRA_REMOTE_LAKE_BIN=~/.elan/bin/lake
# ASTRA_REMOTE_GIT_BIN=~/miniforge3/envs/astra-bench/bin/git
# ASTRA_LOCAL_LEAN4_ROOT=C:\path\to\pinned\mathlib4-v4.30.0
# ASTRA_LOCAL_LAKE_BIN=C:\path\to\lake.exe
# ASTRA_LOCAL_LEAN4_WSL_ROOT=/home/user/astra-benchmarks/mathlib4-v4.30.0
# ASTRA_LOCAL_LEAN4_WSL_LAKE_BIN=/home/user/.elan/bin/lake
# ASTRA_REMOTE_UDOCKER_BIN=~/miniforge3/envs/astra-bench/bin/udocker
# ASTRA_REMOTE_UDOCKER_DIR=~/astra-benchmarks/udocker
# ASTRA_REMOTE_AINSTEIN_EVAL_ROOT=~/astra-benchmarks/ainstein-evals
# ASTRA_AINSTEIN_IMAGE_NAMESPACE=shuoxin
#
# Optional project and independent-CAS adapters
# ASTRA_GR_PYTHON_ROOT=C:\path\to\GR_python
# ASTRA_QUANTUM_TRANSPORT_EOM_ROOT=C:\path\to\QuantumTransportEOM
# ASTRA_QUANTUM_TRANSPORT_EOM_PYTHON=C:\path\to\python.exe
# ASTRA_PYWARPFACTORY_ROOT=C:\path\to\pyWarpFactory
# ASTRA_WARPBUBBLE_OPT_ROOT=C:\path\to\warpbubble-optimization
# ASTRA_MATHEMATICA_BRIDGE_ROOT=C:\path\to\mathematica-agent-bridge

# A request with definitions and an explicit "Claim:" line skips the round
# where the proposers criticise each other; the merge still sees both.
ASTRA_CONJECTURE_SKIP_CRITIQUE_WHEN_POSED=0
