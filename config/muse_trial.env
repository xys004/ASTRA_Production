# Local, reversible 30-day Muse comparison profile.
# This is loaded only while config/muse_trial.enabled exists.
ASTRA_ARCHITECTURE_PROFILE=muse-trial
ASTRA_CONJECTURE_PROVIDER=codex_cli,agy_cli,muse_cli
ASTRA_TRANSLATOR_PROVIDER=claude_cli
ASTRA_REVIEWER_PROVIDER=codex_cli
ASTRA_ANALYST_PROVIDER=codex_cli
ASTRA_NAVIGATOR_PROVIDER=agy_cli
ASTRA_SYNTH_PROVIDER=codex_cli
ASTRA_MUSE_WSL_DISTRO=Debian
ASTRA_MUSE_MODELS=muse-spark-1.3
ASTRA_MUSE_REASONING=high
