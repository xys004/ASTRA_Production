# ASTRA production profile for a macOS workstation.
# Copy to ../.env and replace only the values explicitly marked CONFIGURE.
# Never commit .env, CLI login tokens, SSH private keys, or Tailscale state.

ASTRA_PROVIDER=codex_cli
ASTRA_ARCHITECTURE_PROFILE=full

ASTRA_CONJECTURE_PROVIDER=codex_cli,agy_cli
ASTRA_TRANSLATOR_PROVIDER=claude_cli
ASTRA_REVIEWER_PROVIDER=codex_cli
ASTRA_ANALYST_PROVIDER=codex_cli
ASTRA_NAVIGATOR_PROVIDER=agy_cli
ASTRA_SYNTH_PROVIDER=codex_cli

ASTRA_CLAUDE_MODELS=claude-opus-4-8,sonnet
ASTRA_CODEX_MODELS=gpt-5.6-sol
ASTRA_CODEX_REASONING=xhigh
ASTRA_AGY_MODELS=gemini-3.1-pro-high,gemini-3.5-flash-high
ASTRA_AGY_EFFORT=high
ASTRA_TRANSLATOR_MODELS=claude-opus-4-8,sonnet

ASTRA_CODE_REVIEW=1
ASTRA_REVIEW_MAX_REVISIONS=1
ASTRA_NAVIGATE_AFTER_CYCLE=1
ASTRA_VALIDATOR_REPAIR_VNEXT=1
ASTRA_VALIDATOR_REPAIR_STRATEGY=local-patch
ASTRA_VNEXT_MODEL_PATCH_MAX_REVISIONS=1
ASTRA_MAX_CONCURRENT_CYCLES=1

# The Python/SymPy/Z3/SciPy stack is local. Heavy or specialized validation is
# routed to ASTRUM, where SageMath, Maxima, Cadabra, Lean and company packages
# are maintained centrally. This avoids reproducing fragile CAS environments
# on every laptop.
ASTRA_REQUIRED_LOCAL_ENGINES=z3
ASTRA_ORACLE_MODE=remote
ASTRA_ORACLE_TIMEOUT=600

# CONFIGURE OUT OF BAND with the ASTRUM administrator.
ASTRA_REMOTE_HOST=your-astrum-user@your-tailscale-host
ASTRA_REMOTE_PYTHON=~/astra-worker/venv/bin/python
ASTRA_REMOTE_WORKER=~/astra-worker/astra_remote_worker.py
ASTRA_REMOTE_WORKDIR=~/astra-worker/workspace
ASTRA_REMOTE_CONNECT_TIMEOUT=15
ASTRA_REMOTE_ENGINE_RUNNER=~/astra-worker/astra_engine.sh
ASTRA_REMOTE_SSH_OPTIONS=-i /Users/YOUR_MAC_USER/.ssh/astra_astrum_ed25519 -o "ProxyCommand=tailscale nc %h %p"

# Pinned formal environment on ASTRUM.
ASTRA_REMOTE_LEAN4_ROOT=~/astra-benchmarks/mathlib4-v4.30.0
ASTRA_REMOTE_LAKE_BIN=~/.elan/bin/lake
ASTRA_REMOTE_GIT_BIN=~/miniforge3/envs/astra-bench/bin/git

# Optional local integrations. Leave unset unless the package is also cloned
# onto this Mac; their authoritative maintained copies remain on ASTRUM.
# ASTRA_GR_PYTHON_ROOT=/Users/YOUR_MAC_USER/Dev/GR_python
# ASTRA_PYWARPFACTORY_ROOT=/Users/YOUR_MAC_USER/Dev/pyWarpFactory
# ASTRA_WARPBUBBLE_OPT_ROOT=/Users/YOUR_MAC_USER/Dev/warpbubble-optimization
# ASTRA_MATHEMATICA_BRIDGE_ROOT=/Users/YOUR_MAC_USER/Dev/mathematica-agent-bridge
