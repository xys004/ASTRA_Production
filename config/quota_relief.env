# Opt-in codex quota relief. Loaded only while config/quota_relief.enabled
# exists (toggle with scripts/enable_quota_relief.ps1 / disable_quota_relief.ps1),
# so removing the marker restores the prior .env without editing it.
#
# It moves ONLY the synthesizer (conjecture-merge) off the weekly-limited codex
# account to agy, whose quota is a separate pool. The anti-cheat reviewer gate,
# the analyst verdict, and codex-as-proposer all stay on codex, so the
# science-critical roles are unchanged. The architecture contract recognizes
# this as the 'quota-relief' profile (astra-quota-relief-v1).
#
# Do NOT enable together with muse_trial: both set ASTRA_ARCHITECTURE_PROFILE.
ASTRA_ARCHITECTURE_PROFILE=quota-relief
ASTRA_SYNTH_PROVIDER=agy_cli
# Pin the synth to agy's top model with no flash fallback, so a degraded run
# never silently synthesizes the consensus conjecture on gemini-flash.
ASTRA_SYNTH_MODELS=gemini-3.1-pro-high
